
:root {
  --cor-primaria: #166534;         
  --cor-primaria-escura: #14532d;
  --cor-acento: #dc2626;           
  --cor-milho: #eab308;            
  --cor-acento-claro: #fef9c3;
  --cor-texto: #1f2937;
  --cor-texto-suave: #4b5563;
  --cor-fundo: #f3f6f1;
  --cor-card: #ffffff;
  --cor-borda: #d6ddd2;
  --cor-link-visitado: #6b3fa0;
  --raio: 12px;
  --raio-card: 10px;
  --sombra: 0 4px 16px rgba(0, 0, 0, 0.08);
  --transicao-padrao: transform 0.2s ease, box-shadow 0.2s ease;
}


body {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  font-family: "Segoe UI", Tahoma, Arial, sans-serif;
  font-size: 1rem;
  line-height: 1.6;
  background: var(--cor-fundo);
  color: var(--cor-texto);
}


html {
  scroll-padding-top: 5rem;
}

h1, h2, h3, .logo {
  font-family: Georgia, "Times New Roman", serif;
  line-height: 1.25;
}

h1 { font-size: 2.2rem; color: var(--cor-primaria); }
h2 { font-size: 1.5rem; margin-bottom: 0.75rem; }
h3 { font-size: 1.15rem; margin: 1rem 0 0.5rem; }

p { margin-bottom: 0.75rem; }

a:link { color: var(--cor-primaria); text-decoration: none; }
a:visited { color: var(--cor-link-visitado); }
a:hover { text-decoration: underline; }
a:active { color: var(--cor-acento); }

a:focus-visible,
button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
  outline: 3px solid var(--cor-milho);
  outline-offset: 2px;
}

  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.88);   /* translúcido: o conteúdo aparece borrado por trás */
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--cor-borda);
}

.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  max-width: 1100px;
  margin: 0 auto;
  padding: 0.5rem 1.5rem;
}

.logo {
  font-size: 1.25rem;
  font-weight: 700;
}

.menu {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  list-style: none;
}

.menu a {
  display: inline-block;
  padding: 0.5rem 0;
  color: var(--cor-texto);
  border-bottom: 2px solid transparent;
  transition: color 0.2s ease, border-color 0.2s ease;
}

.menu a:hover {
  color: var(--cor-primaria);
  text-decoration: none;
}

  color: var(--cor-primaria);
  border-bottom-color: var(--cor-primaria);
}

.tem-dropdown {
  position: relative;
}

.dropdown {
  display: none;
  position: absolute;
  top: 100%;
  left: 0;
  z-index: 1;
  min-width: 11rem;
  padding: 0.5rem 0;
  list-style: none;
  background: var(--cor-card);
  border: 1px solid var(--cor-borda);
  border-radius: 8px;
  box-shadow: var(--sombra);
}

.dropdown a {
  display: block;
  padding: 0.5rem 1rem;
}

+
.tem-dropdown:hover .dropdown,
.tem-dropdown:focus-within .dropdown {
  display: block;
}


.menu-hamburguer {
  display: none;
  flex-direction: column;
  gap: 5px;
  padding: 0.5rem;
  background: none;
  border: none;
  cursor: pointer;
}

.menu-hamburguer .barra {
  width: 24px;
  height: 3px;
  background: var(--cor-texto);
  border-radius: 2px;
}

  flex: 1;                    
  display: grid;
  gap: 1.5rem;
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
  padding: 1.5rem 1rem 2rem;
  grid-template-columns: 1fr;
  grid-template-areas:
    "sobre"
    "pratos"
    "comparativo"
    "grafico"
    "destaque"
    "sugestao";
}

.sobre       { grid-area: sobre; }
.area-pratos { grid-area: pratos; }
.comparativo { grid-area: comparativo; }
.grafico     { grid-area: grafico; }
.destaque    { grid-area: destaque; }
.card-sugestao { grid-area: sugestao; }

   Combinador de filho direto: só as <section> que são filhas do .conteudo. */
.conteudo > section {
  min-width: 0;
}

#pratos,
.comparativo,
.grafico,
.destaque,
.card-sugestao {
  background: var(--cor-card);
  border-radius: var(--raio);
  box-shadow: var(--sombra);
  padding: 1.5rem;
}

.sobre {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  align-items: center;
  gap: 2rem;
  padding: 2.5rem;
  overflow: hidden;
  color: #ffffff;
  background: var(--cor-primaria-escura);
  border-radius: var(--raio);
}

.sobre h1 {
  margin-bottom: 0.75rem;
  font-size: clamp(2.2rem, 5vw, 3.4rem);   /* cresce com a tela, com mínimo e máximo */
  color: #ffffff;
}

/* h1 + p: o parágrafo logo depois do título (combinador de irmão adjacente) */
.sobre h1 + p {
  font-size: 1.2rem;
  color: #dcfce7;
}

.sobre-texto {
  max-width: 34rem;
}

.sobre-acoes {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin: 1.25rem 0;
}
a.botao:link,
a.botao:visited,
a.botao-contorno:link,
a.botao-contorno:visited {
  display: inline-block;
  padding: 0.75rem 1.5rem;
  font-weight: 600;
  text-decoration: none;
  border-radius: 8px;
  transition: background-color 0.2s ease, color 0.2s ease;
}

.sobre a.botao:link,
.sobre a.botao:visited {
  color: var(--cor-primaria-escura);
  background: var(--cor-milho);
}

.sobre a.botao:hover {
  background: #facc15;
  text-decoration: none;
}

a.botao-contorno:link,
a.botao-contorno:visited {
  color: #ffffff;
  border: 2px solid #ffffff;
}

a.botao-contorno:hover {
  color: var(--cor-primaria-escura);
  background: #ffffff;
  text-decoration: none;
}

.sobre-favorito {
  margin: 0;
  font-size: 0.95rem;
  color: #bbf7d0;
}

.sobre-imagem {
  width: 100%;
  border-radius: var(--raio);
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
}

/* repeat(auto-fit, minmax()) cria as colunas sozinho, sem media query */
.grade-pratos {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 1.25rem;
  margin-top: 1rem;
}

.card-prato {
  position: relative;
  z-index: 1;
  background: var(--cor-fundo);
  border: 2px solid var(--cor-borda);
  border-radius: var(--raio-card);
  padding: 1rem;
  transition: var(--transicao-padrao);
}

.card-prato::before {
  content: "\2605";
  position: absolute;
  top: 8px;
  right: 12px;
  color: var(--cor-milho);
}

.card-prato:hover {
  transform: translateY(-4px);
  box-shadow: var(--sombra);
}

.card-prato h3 {
  margin-top: 0;
  padding-right: 1.5rem;     
}

.card-prato h3 + .meta {
  color: var(--cor-texto-suave);
  font-size: 0.9rem;
}

.pontuacao {
  margin: 0.5rem 0 0;
  font-size: 0.9rem;
  font-weight: 600;
}

.faixa-imperdivel { border-color: #166534; }
.faixa-muito-bom  { border-color: #1d4ed8; }
.faixa-regular    { border-color: #b45309; }
.faixa-evitar     { border-color: #b91c1c; }

.faixa-imperdivel .pontuacao { color: #166534; }
.faixa-muito-bom .pontuacao  { color: #1d4ed8; }
.faixa-regular .pontuacao    { color: #b45309; }
.faixa-evitar .pontuacao     { color: #b91c1c; }

.resumo-catalogo {
  margin: 1rem 0;
  padding: 0.75rem 1rem;
  background: var(--cor-acento-claro);
  border: 1px solid var(--cor-milho);
  border-radius: var(--raio);
}

.resumo-catalogo h3 {
  margin: 0 0 0.25rem;
  font-size: 1.05rem;
}

.resumo-catalogo ul {
  list-style: none;
  font-size: 0.9rem;
}



.rolagem-tabela {
  overflow-x: auto;            
}

.tabela-notas {
  width: 100%;
  border-collapse: collapse;
}

.tabela-notas caption {
  padding-bottom: 0.5rem;
  text-align: left;
  color: var(--cor-texto-suave);
  font-size: 0.9rem;
}

.tabela-notas th,
.tabela-notas td {
  padding: 0.5rem 0.75rem;
  border: 1px solid var(--cor-borda);
  text-align: left;
}

.tabela-notas th {
  background: var(--cor-fundo);
  font-weight: 600;
}


.tabela-notas tbody tr:nth-child(even) {
  background: #f8faf6;
}

.grafico canvas {
  border: 1px solid var(--cor-borda);
  border-radius: 8px;
}

.foto-destaque {
  position: relative;          
  max-width: 560px;
}

.foto-destaque img {
  border-radius: var(--raio-card);
}

.foto-destaque figcaption {
  margin-top: 0.5rem;
  color: var(--cor-texto-suave);
  font-size: 0.9rem;
}

.selo {
  position: absolute;
  top: 0.75rem;
  left: 0.75rem;
}

.destaque video {
  width: 100%;
  max-width: 560px;
  background: #000000;
  border-radius: 8px;
}

.aviso-formato {
  display: block;
  margin: 0.5rem 0 1rem;
  color: var(--cor-texto-suave);
}

.card-sugestao fieldset {
  display: grid;
  gap: 0.35rem;
  margin-bottom: 1rem;
  padding: 1rem;
  border: 1px solid var(--cor-borda);
  border-radius: 8px;
}

.card-sugestao legend {
  padding: 0 0.5rem;
  font-weight: 600;
}

.card-sugestao input[type="text"],
.card-sugestao input[type="number"],
.card-sugestao input[type="email"],
.card-sugestao select,
.card-sugestao textarea {
  width: 100%;
  padding: 0.6rem 0.8rem;
  font: inherit;
  border: 2px solid var(--cor-borda);
  border-radius: 8px;
  transition: border-color 0.2s ease;
}

.card-sugestao input:focus,
.card-sugestao select:focus,
.card-sugestao textarea:focus {
  border-color: var(--cor-primaria);
}

.campo-check {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-top: 0.5rem;
}

.botao {
  padding: 0.75rem 1.5rem;
  font: inherit;
  font-weight: 600;
  color: #ffffff;
  background: var(--cor-primaria);
  border: none;
  border-radius: 8px;
  cursor: pointer;
}

.botao:hover {
  background: var(--cor-primaria-escura);
}


.rodape {
  padding: 1.5rem 1rem 2rem;
  text-align: center;
  color: var(--cor-texto-suave);
  border-top: 1px solid var(--cor-borda);
}

.rodape a:link    { color: var(--cor-primaria); text-decoration: none; }
.rodape a:visited { color: var(--cor-link-visitado); }
.rodape a:hover   { text-decoration: underline; }
.rodape a:active  { color: var(--cor-acento); }

@media (min-width: 900px) {
  /* Telas grandes: tabela e gráfico lado a lado */
  .conteudo {
    grid-template-columns: 3fr 2fr;
    grid-template-areas:
      "sobre sobre"
      "pratos pratos"
      "comparativo grafico"
      "destaque destaque"
      "sugestao sugestao";
  }
}

@media (max-width: 640px) {
  .menu-hamburguer { display: flex; }
  .menu { display: none; }
}

@media (max-width: 760px) {
  .sobre {
    grid-template-columns: 1fr;
    padding: 1.75rem 1.25rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .card-prato,
  .menu a,
  .card-sugestao input,
  .card-sugestao select,
  .card-sugestao textarea {
    transition: none;
  }
  .card-prato:hover {
    transform: none;
  }
}
